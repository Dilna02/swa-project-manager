# Copy to .env.local for local runs. On Vercel, set these in Project Settings > Environment Variables.

# Neon Postgres connection string (copied from the Neon or Vercel Postgres integration)
DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Set automatically by Vercel when a Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=

# Only used on the very first run, when no seed.json is present
ADMIN_USER=you@company.com
ADMIN_PASSWORD=choose-a-long-password
